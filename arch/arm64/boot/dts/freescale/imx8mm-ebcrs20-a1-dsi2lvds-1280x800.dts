&gpio3 {
	pcie-clk-req {
		gpio-hog;
		gpios = <16 GPIO_ACTIVE_HIGH>;
		output-low;
		line-name = "pcie-clk-req";
	};
};

&iomuxc {
	pinctrl_gpio_hog: hogmux {
		fsl,pins = <
			MX8MM_IOMUXC_NAND_READY_B_GPIO3_IO16	0x41	/* PCIE_ZCLKREQ */
		>;
	};

	pinctrl_bkl: bklgrp {
		fsl,pins = <
			MX8MM_IOMUXC_SAI3_RXD_GPIO4_IO30	0x10		/* LCD0_VDD_EN */
			MX8MM_IOMUXC_UART1_RXD_GPIO5_IO22	0x19		/* LCD0_BKLT_PWR_EN */
			MX8MM_IOMUXC_SAI5_MCLK_GPIO3_IO25	0x19		/* LCD0_BKLT_EN */
			MX8MM_IOMUXC_SAI1_RXD7_GPIO4_IO9	0x116	    /* LVDS_STBY -> SAI6_MCLK */
			MX8MM_IOMUXC_SAI1_TXD7_GPIO4_IO19	0x19		/* LVDS_RESET -> SAI1_TXD7 */
		>;
	};
};