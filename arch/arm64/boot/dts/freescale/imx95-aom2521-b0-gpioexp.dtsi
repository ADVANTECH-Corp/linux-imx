&lpi2c7 {
	gpio_exp1: pca6416@20 {
		compatible = "nxp,pca6416";
		#gpio-cells = <2>;
		gpio-controller;
		reg = <0x20>;
		interrupt-controller;
		#interrupt-cells = <2>;
		interrupt-parent = <&gpio5>;
		interrupts = <10 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_gpioexp1>;
		vcc-supply = <&reg_3p3v>;

		LTE_PWR_EN {
			gpio-hog;
			gpios = <0 GPIO_ACTIVE_HIGH>;
			output-high;
			line-name = "LTE_PWR_EN";
		};
	};

	gpio_exp2: pca6416@21 {
		compatible = "nxp,pca6416";
		#gpio-cells = <2>;
		gpio-controller;
		reg = <0x21>;
		interrupt-controller;
		#interrupt-cells = <2>;
		interrupt-parent = <&gpio5>;
		interrupts = <11 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_gpioexp2>;
		vcc-supply = <&reg_3p3v>;
	};
};

&scmi_iomuxc {
	pinctrl_gpioexp1: gpioexp1grp {
		fsl,pins = <
			IMX95_PAD_XSPI1_SS0_B__GPIO5_IO_BIT10		0x31e
		>;
	};

	pinctrl_gpioexp2: gpioexp2grp {
		fsl,pins = <
			IMX95_PAD_XSPI1_SS1_B__GPIO5_IO_BIT11		0x31e
		>;
	};
};
