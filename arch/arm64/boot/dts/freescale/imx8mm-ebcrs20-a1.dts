/dts-v1/;

#include <dt-bindings/usb/pd.h>
#include "imx8mm-ebcrs20-a1.dtsi"

/ {
	model = "Advantech RISC Single Board";
	compatible = "fsl,imx8mm-evk", "fsl,imx8mm";

	board {
		compatible = "proc-board";
		board-type = "ebc-rs20 A1";
		board-cpu = "IMX8MM";
	};

	aliases {
                rtc0 = &s35390a;
                rtc1 = &snvs_rtc;
	};

	// uart1_mod_reset: uart1-mod-reset {
	// 	compatible = "gpio-reset";
	// 	reset-gpios = <&gpio2 6 GPIO_ACTIVE_LOW>;
	// 	reset-delay-us = <2000>;
	// 	reset-post-delay-ms = <40>;
	// 	#reset-cells = <0>;
	// };

	// sd1_mod_reset: sd1-mod-reset {
	// 	compatible = "gpio-reset";
	// 	reset-gpios = <&gpio2 10 GPIO_ACTIVE_LOW>;
	// 	reset-delay-us = <2000>;
	// 	reset-post-delay-ms = <40>;
	// 	#reset-cells = <0>;
	// };

	// reg_sd1_vmmc: sd1_regulator {
	// 	compatible = "regulator-fixed";
	// 	regulator-name = "WLAN_EN";
	// 	regulator-min-microvolt = <3300000>;
	// 	regulator-max-microvolt = <3300000>;
	// 	gpio = <&gpio2 10 GPIO_ACTIVE_HIGH>;
	// 	off-on-delay-us = <20000>;
	// 	startup-delay-us = <100>;
	// 	enable-active-high;
	// };

	usdhc1_pwrseq: usdhc1_pwrseq {
		compatible = "mmc-pwrseq-simple";
		reset-gpios = <&gpio2 10 GPIO_ACTIVE_LOW>;
		post-power-on-delay-ms = <100>;
	};

	// reg_usb_otg1_vbus: regulator-vbus {
	// 	compatible = "regulator-fixed";
	// 	regulator-name = "usb_otg1_vbus";
	// 	regulator-min-microvolt = <5000000>;
	// 	regulator-max-microvolt = <5000000>;
	// 	gpio = <&gpio5 7 GPIO_ACTIVE_HIGH>;
	// 	enable-active-high;
	// };

        // sound {
        //         compatible = "fsl,sgtl5000",
        //                      "fsl,imx-audio-sgtl5000";
        //         model = "sgtl5000";
        //         codec-master;
        //         ssi-controller = <&sai1>;
        //         audio-codec = <&codec>;
        //         audio-routing =
        //                 "MIC_IN", "Mic Jack",
        //                 "Mic Jack", "Mic Bias",
        //                 "Headphone Jack", "HP_OUT";
        //         no-audmux;
        // };

	rt5640-sound0 {
		compatible = "simple-audio-card";
		simple-audio-card,format = "i2s";
		simple-audio-card,name = "nxp,rt5640-codec";
		simple-audio-card,mclk-fs = <512>;
		// simple-audio-card,mclk-fs = <256>;
		status = "okay";

		simple-audio-card,widgets =
			"Microphone", "Microphone Jack",
			"Headphone", "Headphone Jack";
		simple-audio-card,routing =
			"IN1P", "Microphone Jack",
			"Microphone Jack", "MICBIAS1",
			"Headphone Jack", "HPOL",
			"Headphone Jack", "HPOR";

		simple-audio-card,cpu {
			sound-dai = <&sai1>;
			bitclock-master;
			frame-master;
		};
		simple-audio-card,codec {
			sound-dai = <&rt5640_a0>;
		};
	};

        // uart3_mode:uart3-mode {
        //         compatible = "uart-mode";
        //         status = "okay";

        //         index = <2>;
        //         default_mode = <0>;//RS232
        //         rs232_mode_table = <1 0 1>;
        //         rs485_mode_table = <0 1 1>;

        //         sel0_gpio = <&gpio5 1 GPIO_ACTIVE_HIGH>;
        //         sel1_gpio = <&gpio5 4 GPIO_ACTIVE_HIGH>;
        //         term_gpio = <&gpio4 29 GPIO_ACTIVE_HIGH>;
        // };

	misc-adv-gpio {
		compatible = "misc-adv-gpio";
		pinctrl-names = "default";
		pinctrl-0 = <&adv_gpio_pinmux>;
		status = "okay";
		reset-gpios = <&gpio1 0 GPIO_ACTIVE_LOW>;
		reset-delay = <50>;
		minipcie-reset-gpio = <&gpio3 24 GPIO_ACTIVE_LOW>;
		en-gpios =<&gpio3 20 GPIO_ACTIVE_HIGH>,<&gpio5 7 GPIO_ACTIVE_HIGH>,
			    <&gpio1 6 GPIO_ACTIVE_HIGH>,<&gpio3 22 GPIO_ACTIVE_LOW>,<&gpio3 23 GPIO_ACTIVE_HIGH>;
		timing-interval = <300>;
	};

	leds {
		compatible = "gpio-leds";
        pinctrl-names = "default";
        pinctrl-0 = <&pinctrl_led>;

        led-user {
            label = "user-led";
            gpios = <&gpio5 1 GPIO_ACTIVE_HIGH>;
            default-state = "on";
        };
	};
};

&snvs_rtc {
	status = "disabled";
};

&flexspi {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_flexspi>;
	status = "okay";

	qspi_nor: w25q64fwssig@0 {
                reg = <0>;
                #address-cells = <1>;
                #size-cells = <1>;
                compatible = "jedec,spi-nor", "winbond,w25q64";
                spi-max-frequency = <29000000>;
                spi-nor,quad-read = <4>;
        };
};

&uart4 { /* M4 debug */
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart4>;
	en-gpio = <&gpio5 6 GPIO_ACTIVE_HIGH>;
	status = "okay";
};

&usbotg2 {
	dr_mode = "host";

	status = "okay";
};

&usdhc1 { /* wifi bt */
	pinctrl-names = "default", "state_100mhz", "state_200mhz";
	pinctrl-0 = <&pinctrl_usdhc1>, <&pinctrl_usdhc1_gpio>;
	pinctrl-1 = <&pinctrl_usdhc1_100mhz>, <&pinctrl_usdhc1_gpio>;
	pinctrl-2 = <&pinctrl_usdhc1_200mhz>, <&pinctrl_usdhc1_gpio>;
	bus-width = <4>;
	// vmmc-supply = <&reg_sd1_vmmc>;
	// resets = <&sd1_mod_reset>;
	pm-ignore-notify;
	keep-power-in-suspend;
	non-removable;

	fsl,sdio-async-interrupt-enabled;
	wakeup-source;
	mmc-pwrseq = <&usdhc1_pwrseq>;
	keep-power-in-suspend;
	wifi-pwr-en-gpios = <&gpio4 1 GPIO_ACTIVE_HIGH>;
	wifi-pdn-gpios = <&gpio2 7 GPIO_ACTIVE_HIGH>;

	status = "okay";

	wifi_wake_host {
		compatible = "nxp,wifi-wake-host";
		interrupt-parent = <&gpio4>;
		interrupts = <8 IRQ_TYPE_LEVEL_LOW>;
		interrupt-names = "host-wake";
	};
};

&usdhc3 {
	assigned-clocks = <&clk IMX8MM_CLK_USDHC3_ROOT>;
	assigned-clock-rates = <400000000>;
	pinctrl-names = "default", "state_100mhz", "state_200mhz";
	pinctrl-0 = <&pinctrl_usdhc3>;
	pinctrl-1 = <&pinctrl_usdhc3_100mhz>;
	pinctrl-2 = <&pinctrl_usdhc3_200mhz>;
	bus-width = <8>;
	non-removable;
	cqe-disabled;
	status = "okay";
};

&i2c4 {
	clock-frequency = <100000>;
	pinctrl-names = "default", "gpio";
	pinctrl-0 = <&pinctrl_i2c4>;
	pinctrl-1 = <&pinctrl_i2c4_gpio>;
	scl-gpios = <&gpio5 20 GPIO_ACTIVE_HIGH>;
	sda-gpios = <&gpio5 21 GPIO_ACTIVE_HIGH>;
	status = "okay";

	// 24c32@50 {
    //             compatible = "atmel,24c32";
    //             reg = <0x50>;
    //     };
};

&pwm4 {
        status = "disabled";
        pinctrl-names = "default";
        pinctrl-0 = <&pinctrl_pwm4>;
		status = "okay";
};

&iomuxc {
        pinctrl_hog: hoggrp {
		fsl,pins = <
			MX8MM_IOMUXC_ECSPI2_MOSI_GPIO5_IO11		0x116	/* MAC_RXER */
			MX8MM_IOMUXC_SAI3_RXFS_GPIO4_IO28		0x116	/* VDD_1V8_EN */

			MX8MM_IOMUXC_SD1_STROBE_GPIO2_IO11	0x116	/* VDD_CORE_EN */
			MX8MM_IOMUXC_SAI1_RXFS_GPIO4_IO0	0x116	/* COLD_RST_EN */

			MX8MM_IOMUXC_UART1_TXD_GPIO5_IO23	0x116	/* USB_EN_D_OC */
			MX8MM_IOMUXC_UART2_RXD_GPIO5_IO24	0x116	/* HUB_RESET_GPIO */
			MX8MM_IOMUXC_UART2_TXD_GPIO5_IO25	0x116	/* +V12_EN */
			MX8MM_IOMUXC_ECSPI1_MISO_GPIO5_IO8	0x116	/* V3.3_EN_GPIO */
			MX8MM_IOMUXC_ECSPI1_SS0_GPIO5_IO9	0x116	/* CAN_RST# */
			MX8MM_IOMUXC_GPIO1_IO01_GPIO1_IO1	0x116	/* USB_5V_C_EN */
			MX8MM_IOMUXC_GPIO1_IO05_GPIO1_IO5	0x116	/* WAKE_INT */

			// MX8MM_IOMUXC_SAI1_TXD1_GPIO4_IO13	0x116	/* SAI1_TXD1 BOOT_CFG9 */
			// MX8MM_IOMUXC_SAI1_TXD2_GPIO4_IO14	0x116	/* SAI1_TXD2 BOOT_CFG10 */
			// MX8MM_IOMUXC_SAI1_TXD3_GPIO4_IO15	0x116	/* SAI1_TXD3 BOOT_CFG11 */
			// MX8MM_IOMUXC_SAI1_TXD4_GPIO4_IO16	0x116	/* SAI1_TXD4 BOOT_CFG12 */
			// MX8MM_IOMUXC_SAI1_TXD6_GPIO4_IO18	0x116	/* SAI1_TXD6 BOOT_CFG14 */
			// MX8MM_IOMUXC_SAI1_RXD1_GPIO4_IO3	0x116	/* SAI1_RXD1 BOOT_CFG1 */
			// MX8MM_IOMUXC_SAI1_RXD2_GPIO4_IO4	0x116	/* SAI1_RXD2 BOOT_CFG2 */
			// MX8MM_IOMUXC_SAI1_RXD3_GPIO4_IO5	0x116	/* SAI1_RXD3 BOOT_CFG3 */
			// MX8MM_IOMUXC_SAI1_RXD5_GPIO4_IO7	0x116	/* SAI1_RXD5 BOOT_CFG5 */

			MX8MM_IOMUXC_GPIO1_IO12_GPIO1_IO12	0x19		/* GPIO1_R */
			MX8MM_IOMUXC_GPIO1_IO14_GPIO1_IO14	0x19		/* GPIO2_R */
		>;
	};

	pinctrl_i2c4: i2c4grp {
		fsl,pins = <
			MX8MM_IOMUXC_I2C4_SCL_I2C4_SCL			0x400001c3	/* I2C_GP_CK */
			MX8MM_IOMUXC_I2C4_SDA_I2C4_SDA			0x400001c3	/* I2C_GP_DAT */
		>;
	};

	pinctrl_i2c4_gpio: i2c4_gpio_grp {
		fsl,pins = <
			MX8MM_IOMUXC_I2C4_SCL_GPIO5_IO20		0x19
			MX8MM_IOMUXC_I2C4_SDA_GPIO5_IO21		0x19
		>;
	};

	pinctrl_uart4: uart4grp {
		fsl,pins = <
			MX8MM_IOMUXC_UART4_RXD_UART4_DCE_RX	0x140
			MX8MM_IOMUXC_UART4_TXD_UART4_DCE_TX	0x140
		>;
	};

	pinctrl_flexspi: flexspigrp {
		fsl,pins = <
			MX8MM_IOMUXC_NAND_ALE_QSPI_A_SCLK               0x1c2
			MX8MM_IOMUXC_NAND_CE0_B_QSPI_A_SS0_B            0x82
			MX8MM_IOMUXC_NAND_DATA00_QSPI_A_DATA0           0x82
			MX8MM_IOMUXC_NAND_DATA01_QSPI_A_DATA1           0x82
			MX8MM_IOMUXC_NAND_DATA02_QSPI_A_DATA2           0x82
			MX8MM_IOMUXC_NAND_DATA03_QSPI_A_DATA3           0x82
		>;
	};

	pinctrl_usdhc1_gpio: usdhc1grpgpio {
		fsl,pins = <
			MX8MM_IOMUXC_SD1_RESET_B_GPIO2_IO10		0x41	/* W_WLAN_RST_1V8 */
			MX8MM_IOMUXC_SD1_DATA7_GPIO2_IO9		0x41	/* W_BT_RST_1V8 */

			MX8MM_IOMUXC_SAI1_RXD6_GPIO4_IO8		0x41	/* W_BT/15.4_WAKE_OUT_1V8 */
			MX8MM_IOMUXC_SAI1_RXD4_GPIO4_IO6		0x41	/* W_BT/15.4_WAKE_IN_1V8 */
			MX8MM_IOMUXC_SAI1_TXD5_GPIO4_IO17		0x41	/* W_WLAN_WAKE_IN_1V8 */
			MX8MM_IOMUXC_SAI2_MCLK_GPIO4_IO27		0x41	/* W_WLAN_WAKE_OUT_1V8 */

			MX8MM_IOMUXC_SD1_DATA4_GPIO2_IO6		0x41	/* SD1_INT */

			MX8MM_IOMUXC_GPIO1_IO08_GPIO1_IO8		0x41    /* W_WCI-2_OUT_1V8 */
			MX8MM_IOMUXC_SAI2_TXD0_GPIO4_IO26		0x41    /* W_WCI-2_IN_1V8 */
			MX8MM_IOMUXC_SD1_DATA5_GPIO2_IO7		0x41    /* W_PDN_3V3 */

			MX8MM_IOMUXC_SAI1_RXC_GPIO4_IO1		    0x41	/* WIFI_PWR_EN */
			MX8MM_IOMUXC_SAI2_TXC_GPIO4_IO25	    0x41	/* W_VDD_1V8_EN */
		>;
	};

	pinctrl_usdhc1: usdhc1grp {
		fsl,pins = <
			MX8MM_IOMUXC_SD1_CLK_USDHC1_CLK		0x190
			MX8MM_IOMUXC_SD1_CMD_USDHC1_CMD		0x1d0
			MX8MM_IOMUXC_SD1_DATA0_USDHC1_DATA0	0x1d0
			MX8MM_IOMUXC_SD1_DATA1_USDHC1_DATA1	0x1d0
			MX8MM_IOMUXC_SD1_DATA2_USDHC1_DATA2	0x1d0
			MX8MM_IOMUXC_SD1_DATA3_USDHC1_DATA3	0x1d0
		>;
	};

	pinctrl_usdhc1_100mhz: usdhc1grp100mhz {
		fsl,pins = <
			MX8MM_IOMUXC_SD1_CLK_USDHC1_CLK		0x194
			MX8MM_IOMUXC_SD1_CMD_USDHC1_CMD		0x1d4
			MX8MM_IOMUXC_SD1_DATA0_USDHC1_DATA0	0x1d4
			MX8MM_IOMUXC_SD1_DATA1_USDHC1_DATA1	0x1d4
			MX8MM_IOMUXC_SD1_DATA2_USDHC1_DATA2	0x1d4
			MX8MM_IOMUXC_SD1_DATA3_USDHC1_DATA3	0x1d4
		>;
	};

	pinctrl_usdhc1_200mhz: usdhc1grp200mhz {
		fsl,pins = <
			MX8MM_IOMUXC_SD1_CLK_USDHC1_CLK		0x196
			MX8MM_IOMUXC_SD1_CMD_USDHC1_CMD		0x1d6
			MX8MM_IOMUXC_SD1_DATA0_USDHC1_DATA0	0x1d6
			MX8MM_IOMUXC_SD1_DATA1_USDHC1_DATA1	0x1d6
			MX8MM_IOMUXC_SD1_DATA2_USDHC1_DATA2	0x1d6
			MX8MM_IOMUXC_SD1_DATA3_USDHC1_DATA3	0x1d6
		>;
	};

	pinctrl_usdhc3: usdhc3grp {
		fsl,pins = <
			MX8MM_IOMUXC_NAND_WE_B_USDHC3_CLK		0x190	/* SD3_CLK */
			MX8MM_IOMUXC_NAND_WP_B_USDHC3_CMD		0x1d0	/* SD3_CMD */
			MX8MM_IOMUXC_NAND_DATA04_USDHC3_DATA0		0x1d0	/* SD3_DATA0 */
			MX8MM_IOMUXC_NAND_DATA05_USDHC3_DATA1		0x1d0	/* SD3_DATA1 */
			MX8MM_IOMUXC_NAND_DATA06_USDHC3_DATA2		0x1d0	/* SD3_DATA2 */
			MX8MM_IOMUXC_NAND_DATA07_USDHC3_DATA3		0x1d0	/* SD3_DATA3 */
			MX8MM_IOMUXC_NAND_RE_B_USDHC3_DATA4		0x1d0	/* SD3_DATA4 */
			MX8MM_IOMUXC_NAND_CE2_B_USDHC3_DATA5		0x1d0	/* SD3_DATA5 */
			MX8MM_IOMUXC_NAND_CE3_B_USDHC3_DATA6		0x1d0	/* SD3_DATA6 */
			MX8MM_IOMUXC_NAND_CLE_USDHC3_DATA7		0x1d0	/* SD3_DATA7 */
			MX8MM_IOMUXC_NAND_CE1_B_USDHC3_STROBE 		0x190	/* SD3_STORBE */
		>;
	};

	pinctrl_usdhc3_100mhz: usdhc3-100mhzgrp {
		fsl,pins = <
			MX8MM_IOMUXC_NAND_WE_B_USDHC3_CLK               0x194
			MX8MM_IOMUXC_NAND_WP_B_USDHC3_CMD               0x1d4
			MX8MM_IOMUXC_NAND_DATA04_USDHC3_DATA0           0x1d4
			MX8MM_IOMUXC_NAND_DATA05_USDHC3_DATA1           0x1d4
			MX8MM_IOMUXC_NAND_DATA06_USDHC3_DATA2           0x1d4
			MX8MM_IOMUXC_NAND_DATA07_USDHC3_DATA3           0x1d4
			MX8MM_IOMUXC_NAND_RE_B_USDHC3_DATA4             0x1d4
			MX8MM_IOMUXC_NAND_CE2_B_USDHC3_DATA5            0x1d4
			MX8MM_IOMUXC_NAND_CE3_B_USDHC3_DATA6            0x1d4
			MX8MM_IOMUXC_NAND_CLE_USDHC3_DATA7              0x1d4
			MX8MM_IOMUXC_NAND_CE1_B_USDHC3_STROBE           0x194
		>;
	};

	pinctrl_usdhc3_200mhz: usdhc3-200mhzgrp {
		fsl,pins = <
			MX8MM_IOMUXC_NAND_WE_B_USDHC3_CLK               0x196
			MX8MM_IOMUXC_NAND_WP_B_USDHC3_CMD               0x1d6
			MX8MM_IOMUXC_NAND_DATA04_USDHC3_DATA0           0x1d6
			MX8MM_IOMUXC_NAND_DATA05_USDHC3_DATA1           0x1d6
			MX8MM_IOMUXC_NAND_DATA06_USDHC3_DATA2           0x1d6
			MX8MM_IOMUXC_NAND_DATA07_USDHC3_DATA3           0x1d6
			MX8MM_IOMUXC_NAND_RE_B_USDHC3_DATA4             0x1d6
			MX8MM_IOMUXC_NAND_CE2_B_USDHC3_DATA5            0x1d6
			MX8MM_IOMUXC_NAND_CE3_B_USDHC3_DATA6            0x1d6
			MX8MM_IOMUXC_NAND_CLE_USDHC3_DATA7              0x1d6
			MX8MM_IOMUXC_NAND_CE1_B_USDHC3_STROBE           0x196
		>;
	};

	pinctrl_pwm4: pwm4grp {
		fsl,pins = <
			MX8MM_IOMUXC_SAI3_MCLK_PWM4_OUT         0x06	/* LCD0_BKLT_PWM */
		>;
	};

	pinctrl_led: led_usr {
		fsl,pins = <
			MX8MM_IOMUXC_SAI3_TXD_GPIO5_IO1			0x116	/* LED */
		>;
	};

	adv_gpio_pinmux: advgpio {
		fsl,pins = <
			MX8MM_IOMUXC_SAI5_RXFS_GPIO3_IO19		0x116	/* EAR_PHONE_SHDN */	
			MX8MM_IOMUXC_SAI5_RXC_GPIO3_IO20		0x116	/* AUDIO_GAN1 */
			MX8MM_IOMUXC_ECSPI1_MOSI_GPIO5_IO7		0x116	/* AUDIO_GAN0 */
			MX8MM_IOMUXC_SAI3_RXC_GPIO4_IO29		0x116	/* AMP_MUTE */

			MX8MM_IOMUXC_GPIO1_IO00_GPIO1_IO0		0x116	/* CH334_RST GPIO11 */

			MX8MM_IOMUXC_GPIO1_IO06_GPIO1_IO6		0x41    /* MINICARD_PWR_EN */
			MX8MM_IOMUXC_SAI5_RXD1_GPIO3_IO22		0x41    /* MINICARD_DET# */
			MX8MM_IOMUXC_SAI5_RXD2_GPIO3_IO23		0x41    /* MINICARD_W_DIS# */
			MX8MM_IOMUXC_SAI5_RXD3_GPIO3_IO24		0x41    /* MINICARD_RESET# */

			MX8MM_IOMUXC_SAI5_RXD0_GPIO3_IO21		0x41    /* TCA9545A_RST# */
			MX8MM_IOMUXC_ECSPI2_SCLK_GPIO5_IO10		0x116	/* RS485_RST */ /* CP2105_RST */
			MX8MM_IOMUXC_SPDIF_EXT_CLK_GPIO5_IO5	0x116	/* GPIO_RST# */ /* TCA9538 */
		>;
	};
};
