/ {
	reg_hdmi_3v3: regulator-hdmi-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "+V3.3_HDMI";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};

	reg_hdmi_1v2: regulator-hdmi-1v2 {
		compatible = "regulator-fixed";
		regulator-name = "+V1.2_HDMI";
		regulator-min-microvolt = <1200000>;
		regulator-max-microvolt = <1200000>;
		regulator-always-on;
	};

	sound_hdmi: sound-hdmi {
		compatible = "simple-audio-card";
		simple-audio-card,name = "sound-hdmi";
		simple-audio-card,format = "i2s";

		simple-audio-card,cpu {
			sound-dai = <&sai5>;
			dai-tdm-slot-num = <2>;
			dai-tdm-slot-width = <32>;
		};

		simple-audio-card,codec {
			sound-dai = <&lt9611uxd>;
		};
	};

	hdmi-connector-dsi {
		compatible = "hdmi-connector";
		label = "hdmi";
		type = "a";

		port {
			hdmi_lt9611uxd_in: endpoint {
				remote-endpoint = <&lt9611uxd_out>;
			};
		};
	};
};

&lpi2c2 {
	lt9611uxd: hdmi-bridge@41 {
		compatible = "lontium,lt9611uxd";
		reg = <0x41>;
		#sound-dai-cells = <0>;
		reset-gpios = <&gpio_exp2 5 GPIO_ACTIVE_HIGH>; /* DSI_RST */
		interrupts-extended = <&gpio_exp2 3 IRQ_TYPE_EDGE_FALLING>; /* DSI_HDMI_INT */
		vcc-supply = <&reg_hdmi_3v3>;
		vdd-supply = <&reg_hdmi_1v2>;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				lt9611uxd_from_dsim: endpoint {
					remote-endpoint = <&dsim_to_lt9611uxd>;
				};
			};

			port@2 {
				reg = <2>;
				lt9611uxd_out: endpoint {
					remote-endpoint = <&hdmi_lt9611uxd_in>;
				};
			};
		};
	};
};

&sai5 {
	#sound-dai-cells = <0>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_sai5>;
	assigned-clocks = <&scmi_clk IMX95_CLK_AUDIOPLL1_VCO>,
			  <&scmi_clk IMX95_CLK_AUDIOPLL2_VCO>,
			  <&scmi_clk IMX95_CLK_AUDIOPLL1>,
			  <&scmi_clk IMX95_CLK_AUDIOPLL2>,
			  <&scmi_clk IMX95_CLK_SAI5>;
	assigned-clock-parents = <0>, <0>, <0>, <0>,
				 <&scmi_clk IMX95_CLK_AUDIOPLL1>;
	assigned-clock-rates = <3932160000>,
			       <3612672000>, <393216000>,
			       <361267200>, <12288000>;
	fsl,sai-mclk-direction-output;
	status = "okay";
};

&display_pixel_link {
	status = "okay";
};

&dpu {
	assigned-clocks = <&scmi_clk IMX95_CLK_DISP1PIX>,
			  <&scmi_clk IMX95_CLK_VIDEOPLL1_VCO>,
			  <&scmi_clk IMX95_CLK_VIDEOPLL1>;
	assigned-clock-parents = <&scmi_clk IMX95_CLK_VIDEOPLL1>;
	assigned-clock-rates = <0>, <2673000000>, <297000000>;
};

&mipi_dsi {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@1 {
			reg = <1>;

			dsim_to_lt9611uxd: endpoint {
				remote-endpoint = <&lt9611uxd_from_dsim>;
			};
		};
	};
};

&pixel_interleaver {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	channel@0 {
		reg = <0>;
		status = "okay";
	};
};

&scmi_iomuxc {

	pinctrl_sai5: sai5grp {
		fsl,pins = <
			IMX95_PAD_XSPI1_DATA4__SAI5_TX_DATA_BIT0	0x31e
			IMX95_PAD_XSPI1_DATA5__SAI5_TX_SYNC		0x31e
			IMX95_PAD_XSPI1_DATA6__SAI5_TX_BCLK		0x31e
		>;
	};
};
